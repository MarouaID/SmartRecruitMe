# Database
DATABASE_URL=mysql+pymysql://smartrecruit:password@localhost:3306/smartrecruitme

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# GitHub API (optionnel - augmente le rate limit de 60 à 5000 requêtes/heure)
GITHUB_TOKEN=

# Email Configuration
# Pour Gmail, utilisez un "App Password" : https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-email@gmail.com
SMTP_PASSWORD=votre-app-password
FROM_EMAIL=votre-email@gmail.com
FROM_NAME=SmartRecruitMe

# Pour d'autres fournisseurs:
# Outlook/Hotmail: smtp-mail.outlook.com:587
# Yahoo: smtp.mail.yahoo.com:587
# SendGrid: smtp.sendgrid.net:587
